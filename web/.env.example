# Copy to .env.local and fill in. .env.local is git-ignored; never commit it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=railway_db

# The app connects as this least-privilege user. db:setup creates it.
DB_USER=rail_app
DB_PASSWORD=choose-a-password

# Used only by `npm run db:setup` to build the schema.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=your-mysql-root-password

# Signs login cookies. Any long random string.
JWT_SECRET=replace-with-a-long-random-string
